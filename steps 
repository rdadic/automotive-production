CREATE TABLE vehicles(
    vehicle_id INT NOT NULL, 
    model VARCHAR(10) NOT NULL, 
    drive_type VARCHAR(10) NOT NULL, 
    PRIMARY KEY(vehicle_id)
); 

CREATE TABLE robots(
    robot_id INT NOT NULL, 
    robot_number CHAR(2) NOT NULL,
    ubs_line INT NOT NULL,
    process_area VARCHAR(255), 
    PRIMARY KEY(robot_id)
);

CREATE TABLE process_specifications(
    specification_id INT NOT NULL PRIMARY KEY, 
    vehicle_id INT NOT NULL, 
    robot_number CHAR(2) NOT NULL, 
    seam VARCHAR(255) NOT NULL,
    target_mm DECIMAL(5,2) NOT NULL,
    FOREIGN KEY(vehicle_id) REFERENCES vehicles(vehicle_id) ON DELETE CASCADE ON UPDATE CASCADE
);

CREATE TABLE production(
    production_id INT NOT NULL PRIMARY KEY,
    igef VARCHAR(20) NOT NULL, 
    vehicle_id INT NOT NULL, 
    ubs_line INT NOT NULL, 
    production_datetime DATETIME NOT NULL, 
    FOREIGN KEY(vehicle_id) REFERENCES vehicles(vehicle_id) ON DELETE CASCADE ON UPDATE CASCADE
);

CREATE TABLE production_measurements(
    measurement_id INT NOT NULL PRIMARY KEY,
    production_id INT NOT NULL,
    specification_id INT NOT NULL,
    robot_id INT NOT NULL, 
    actual_mm DECIMAL(5,2) NOT NULL, 
    deviation_mm DECIMAL(5,2), 
    leak boolean, 
    defect boolean,
    FOREIGN KEY(production_id) REFERENCES production(production_id) ON DELETE CASCADE ON UPDATE CASCADE,
    FOREIGN KEY(specification_id) REFERENCES process_specifications(specification_id) ON DELETE CASCADE ON UPDATE CASCADE,
    FOREIGN KEY(robot_id) REFERENCES robots(robot_id)
);

CREATE TABLE vehicle_status(
    igef VARCHAR(20) NOT NULL,
    location VARCHAR(255) NOT NULL,
    date_time DATETIME NOT NULL
);

