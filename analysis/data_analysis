)

for container in ax.containers:
    ax.bar_label(container, fmt="%.0f", padding=3)

plt.title('Hourly production line 1 and line 2')
plt.xlabel('Hour of day')
plt.ylabel('Vehicles produced')
plt.xticks(range(24),rotation=0)
