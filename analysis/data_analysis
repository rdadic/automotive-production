import matplotlib.pyplot as plt

df_analysis['production_datetime'] = pd.to_datetime(df_analysis['production_datetime'])
df_analysis['hour'] = df_analysis['production_datetime'].dt.hour

hourly_production = (
    df_analysis.groupby(['hour','ubs_line'])['igef'].nunique().unstack(fill_value=0).reindex(range(24),fill_value=0)
)

ax = hourly_production.plot(
